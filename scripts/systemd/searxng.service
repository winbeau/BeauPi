[Unit]
Description=Local SearXNG search service (Docker Compose)
Documentation=https://docs.searxng.org/admin/installation-docker.html
ConditionPathExists=%h/.local/share/searxng/compose.yml
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/.local/share/searxng
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecReload=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose stop --timeout 30
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=45s

[Install]
WantedBy=default.target
